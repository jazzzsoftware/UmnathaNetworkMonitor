<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="NetworkMonitor.Views.Controls.TrafficAreaChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <Grid
        Background="Transparent">

        <win2d:CanvasControl
            x:Name="ChartCanvas"
            IsHitTestVisible="False"
            CreateResources="ChartCanvasCreateResources"
            Draw="ChartCanvasDraw" />

        <StackPanel
            x:Name="AxisLabelPanel"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,0,8,0"
            Spacing="1"
            IsHitTestVisible="False">

            <TextBlock
                x:Name="MaxScaleLabel"
                FontSize="14"
                FontWeight="SemiBold"
                Opacity="0.7"
                HorizontalAlignment="Right" />

            <TextBlock
                x:Name="MaxScaleCaption"
                Text="Megabits per second peak"
                FontSize="10"
                Opacity="0.45"
                HorizontalAlignment="Right"
                CharacterSpacing="50" />

            <TextBlock
                x:Name="MaxScaleMBpsLabel"
                FontSize="14"
                FontWeight="SemiBold"
                Opacity="0.7"
                HorizontalAlignment="Right"
                Margin="0,15,0,0" />

            <TextBlock
                x:Name="MaxScaleMBpsCaption"
                Text="Megabytes per second peak"
                FontSize="10"
                Opacity="0.45"
                HorizontalAlignment="Right"
                CharacterSpacing="50" />

        </StackPanel>

        <Line
            x:Name="CrosshairLine"
            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
            StrokeThickness="1"
            StrokeDashArray="4,3"
            Opacity="0.35"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <Border
            x:Name="HoverPanel"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,8"
            MinWidth="130"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Visibility="Collapsed">

            <StackPanel
                Spacing="4">

                <TextBlock
                    x:Name="HoverTimeLabel"
                    FontSize="10"
                    Opacity="0.6" />

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6">

                    <Rectangle
                        Width="8"
                        Height="8"
                        Fill="#1976D2"
                        RadiusX="1"
                        RadiusY="1"
                        VerticalAlignment="Center" />

                    <TextBlock
                        x:Name="HoverDownloadLabel"
                        FontSize="12" />

                </StackPanel>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6">

                    <Rectangle
                        Width="8"
                        Height="8"
                        Fill="#AB47BC"
                        RadiusX="1"
                        RadiusY="1"
                        VerticalAlignment="Center" />

                    <TextBlock
                        x:Name="HoverUploadLabel"
                        FontSize="12" />

                </StackPanel>

            </StackPanel>

        </Border>

        <Grid
            x:Name="InputLayer"
            Background="Transparent"
            PointerMoved="InputLayerPointerMoved"
            PointerExited="InputLayerPointerExited"
            PointerPressed="InputLayerPointerPressed" />

    </Grid>

</UserControl>
