<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="NetworkMonitor.Views.LocalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:chart="using:NetworkMonitor.Views.Controls"
    xmlns:models="using:NetworkMonitor.Models.Traffic"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid
        RowDefinitions="Auto,Auto,*,Auto"
        Padding="16,12,16,12">

        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Margin="0,0,0,4">

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="4">

                <Button
                    x:Name="LensAppButton"
                    Content="By app"
                    Tag="ByApp"
                    Padding="10,5"
                    Click="LensButtonClick" />

                <Button
                    x:Name="LensDeviceButton"
                    Content="By device"
                    Tag="ByDevice"
                    Padding="10,5"
                    Click="LensButtonClick" />

                <TextBlock
                    FontSize="12"
                    Opacity="0.55"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />

            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="4">

                <Button
                    x:Name="Range7dButton"
                    Content="7d"
                    Tag="168"
                    Padding="10,5"
                    Click="RangeButtonClick" />

                <Button
                    x:Name="Range24hButton"
                    Content="24h"
                    Tag="24"
                    Padding="10,5"
                    Click="RangeButtonClick" />

                <Button
                    x:Name="Range6hButton"
                    Content="6h"
                    Tag="6"
                    Padding="10,5"
                    Click="RangeButtonClick" />

                <Button
                    x:Name="Range1hButton"
                    Content="1h"
                    Tag="1"
                    Padding="10,5"
                    Click="RangeButtonClick" />

                <Button
                    x:Name="Range5mButton"
                    Content="5m"
                    Tag="5m"
                    Padding="10,5"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="RangeButtonClick" />

            </StackPanel>

        </Grid>

        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12"
            Margin="0,0,0,10">

            <StackPanel
                Spacing="6">

                <Grid
                    ColumnDefinitions="*,Auto">

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

                        <TextBlock
                            x:Name="ChartLabel"
                            FontSize="14"
                            Opacity="0.8"
                            VerticalAlignment="Center" />

                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="12">

                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="4">

                            <Rectangle
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center"
                                Fill="#1976D2"
                                RadiusX="2"
                                RadiusY="2" />

                            <TextBlock
                                Text="Download"
                                FontSize="11"
                                VerticalAlignment="Center"
                                Opacity="0.7" />

                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="4">

                            <Rectangle
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center"
                                Fill="#AB47BC"
                                RadiusX="2"
                                RadiusY="2" />

                            <TextBlock
                                Text="Upload"
                                FontSize="11"
                                VerticalAlignment="Center"
                                Opacity="0.7" />

                        </StackPanel>

                    </StackPanel>

                    <Border
                        x:Name="ModeBadge"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="13"
                        Padding="14,7"
                        Background="#CC2E7D32"
                        Tapped="ModeBadgeTapped">

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">

                            <Ellipse
                                x:Name="ModeDot"
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                Fill="#FFFFFF" />

                            <TextBlock
                                x:Name="ModeText"
                                FontSize="15"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                                Text="Live" />

                            <TextBlock
                                x:Name="ModeClose"
                                FontSize="15"
                                VerticalAlignment="Center"
                                Opacity="0.7"
                                Visibility="Collapsed"
                                Text="&#x2715;" />

                        </StackPanel>

                    </Border>

                </Grid>

                <Grid>

                    <chart:TrafficAreaChart
                        x:Name="AreaChart"
                        Height="120"
                        ChartPoints="{x:Bind ViewModel.ChartPoints, Mode=OneWay}"
                        SelectedBucketStart="{x:Bind ViewModel.SelectedBucketStart, Mode=OneWay}" />

                    <ProgressRing
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                </Grid>

                <Grid
                    ColumnDefinitions="*,*,*,*,*">

                    <TextBlock
                        Grid.Column="0"
                        x:Name="TimeLabel0"
                        FontSize="10"
                        Opacity="0.45"
                        HorizontalAlignment="Left" />

                    <TextBlock
                        Grid.Column="1"
                        x:Name="TimeLabel1"
                        FontSize="10"
                        Opacity="0.45"
                        HorizontalAlignment="Center" />

                    <TextBlock
                        Grid.Column="2"
                        x:Name="TimeLabel2"
                        FontSize="10"
                        Opacity="0.45"
                        HorizontalAlignment="Center" />

                    <TextBlock
                        Grid.Column="3"
                        x:Name="TimeLabel3"
                        FontSize="10"
                        Opacity="0.45"
                        HorizontalAlignment="Center" />

                    <TextBlock
                        Grid.Column="4"
                        Text="now"
                        FontSize="10"
                        Opacity="0.45"
                        HorizontalAlignment="Right" />

                </Grid>

            </StackPanel>

        </Border>

        <controls:DataGrid
            Grid.Row="2"
            x:Name="AppGrid"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            GridLinesVisibility="Horizontal"
            SelectionMode="Single"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            RowDetailsVisibilityMode="VisibleWhenSelected"
            Loaded="AppGridLoaded"
            SelectionChanged="AppGridSelectionChanged"
            ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">

            <controls:DataGrid.Resources>

                <SolidColorBrush
                    x:Key="DataGridCellFocusVisualPrimaryBrush"
                    Color="Transparent" />

                <SolidColorBrush
                    x:Key="DataGridCellFocusVisualSecondaryBrush"
                    Color="Transparent" />

                <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">0.35</x:Double>

                <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">0.45</x:Double>

                <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">0.3</x:Double>

                <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">0.4</x:Double>

            </controls:DataGrid.Resources>

            <controls:DataGrid.Columns>

                <controls:DataGridTemplateColumn
                    x:Name="GroupColumn"
                    Header="App"
                    Width="*">

                    <controls:DataGridTemplateColumn.CellTemplate>

                        <DataTemplate
                            x:DataType="models:LocalTrafficGroupRow">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6"
                                Padding="8,3,0,3"
                                VerticalAlignment="Center">

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="{x:Bind IsAll, Converter={StaticResource BoolToFontWeightConverter}}"
                                    Text="{x:Bind DisplayName, Mode=OneWay}" />

                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.55"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind HasSubLabel, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                    Text="{x:Bind SubLabel, Mode=OneWay}" />

                                <Border
                                    Background="#FFB300"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind HasServiceTag, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">

                                    <TextBlock
                                        FontSize="10"
                                        Foreground="#000000"
                                        Text="{x:Bind ServiceTag, Mode=OneWay}" />

                                </Border>

                                <Border
                                    Background="#40808080"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind IsBackground, Converter={StaticResource BoolToVisibilityConverter}}">

                                    <TextBlock
                                        FontSize="10"
                                        Opacity="0.8"
                                        Text="discovery only" />

                                </Border>

                                <Border
                                    Background="#332E7D32"
                                    BorderBrush="#552E7D32"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind HasRate, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="5"
                                        VerticalAlignment="Center">

                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            VerticalAlignment="Center"
                                            Fill="#7BC47F" />

                                        <TextBlock
                                            FontSize="10"
                                            Foreground="#7BC47F"
                                            Text="{x:Bind RateText, Mode=OneWay}" />

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </DataTemplate>

                    </controls:DataGridTemplateColumn.CellTemplate>

                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn
                    x:Name="ChildColumn"
                    Header="Peers"
                    Width="180">

                    <controls:DataGridTemplateColumn.CellTemplate>

                        <DataTemplate
                            x:DataType="models:LocalTrafficGroupRow">

                            <TextBlock
                                VerticalAlignment="Center"
                                Opacity="0.75"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ChildTooltip, Mode=OneWay}"
                                Text="{x:Bind ChildSummary, Mode=OneWay}" />

                        </DataTemplate>

                    </controls:DataGridTemplateColumn.CellTemplate>

                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn
                    Header="Download"
                    Width="110">

                    <controls:DataGridTemplateColumn.CellTemplate>

                        <DataTemplate
                            x:DataType="models:LocalTrafficGroupRow">

                            <TextBlock
                                Foreground="#1976D2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Padding="0,0,8,0"
                                Text="{x:Bind DownloadText, Mode=OneWay}" />

                        </DataTemplate>

                    </controls:DataGridTemplateColumn.CellTemplate>

                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn
                    Header="Upload"
                    Width="110">

                    <controls:DataGridTemplateColumn.CellTemplate>

                        <DataTemplate
                            x:DataType="models:LocalTrafficGroupRow">

                            <TextBlock
                                Foreground="#AB47BC"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Padding="0,0,8,0"
                                Text="{x:Bind UploadText, Mode=OneWay}" />

                        </DataTemplate>

                    </controls:DataGridTemplateColumn.CellTemplate>

                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn
                    Header="Total"
                    Width="110">

                    <controls:DataGridTemplateColumn.CellTemplate>

                        <DataTemplate
                            x:DataType="models:LocalTrafficGroupRow">

                            <TextBlock
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Padding="0,0,8,0"
                                FontWeight="{x:Bind IsAll, Converter={StaticResource BoolToFontWeightConverter}}"
                                Text="{x:Bind TotalText, Mode=OneWay}" />

                        </DataTemplate>

                    </controls:DataGridTemplateColumn.CellTemplate>

                </controls:DataGridTemplateColumn>

            </controls:DataGrid.Columns>

            <controls:DataGrid.RowDetailsTemplate>

                <DataTemplate
                    x:DataType="models:LocalTrafficGroupRow">

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="24,6,8,6"
                        Visibility="{x:Bind HasChildren, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">

                        <ItemsControl
                            ItemsSource="{x:Bind Children, Mode=OneWay}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate
                                    x:DataType="models:LocalTrafficLeafRow">

                                    <Grid
                                        ColumnDefinitions="*,110,110,110"
                                        Padding="0,3">

                                        <StackPanel
                                            Grid.Column="0"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind SubLabel}">

                                            <StackPanel
                                                Spacing="1"
                                                VerticalAlignment="Center">

                                                <TextBlock
                                                    FontSize="13"
                                                    Text="{x:Bind DisplayName}" />

                                                <TextBlock
                                                    FontSize="11"
                                                    Opacity="0.55"
                                                    Visibility="{x:Bind HasSubLabel, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Text="{x:Bind SubLabel}" />

                                            </StackPanel>

                                            <Border
                                                Background="#FFB300"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind HasServiceTag, Converter={StaticResource BoolToVisibilityConverter}}">

                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="#000000"
                                                    Text="{x:Bind ServiceTag}" />

                                            </Border>

                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="#1976D2"
                                            FontSize="13"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Padding="0,0,8,0"
                                            Text="{x:Bind DownloadText}" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Foreground="#AB47BC"
                                            FontSize="13"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Padding="0,0,8,0"
                                            Text="{x:Bind UploadText}" />

                                        <TextBlock
                                            Grid.Column="3"
                                            FontSize="13"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Padding="0,0,8,0"
                                            Text="{x:Bind TotalText}" />

                                    </Grid>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Border>

                </DataTemplate>

            </controls:DataGrid.RowDetailsTemplate>

        </controls:DataGrid>

        <TextBlock
            Grid.Row="3"
            Margin="0,8,0,0"
            Opacity="0.65"
            FontSize="12"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />

    </Grid>

</Page>
