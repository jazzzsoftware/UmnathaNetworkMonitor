<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="NetworkMonitor.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>

        <Style
            x:Key="SettingsCard"
            TargetType="Border">

            <Setter
                Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />

            <Setter
                Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefaultBrush}" />

            <Setter
                Property="BorderThickness"
                Value="1" />

            <Setter
                Property="CornerRadius"
                Value="6" />

            <Setter
                Property="Padding"
                Value="16" />

        </Style>

        <Style
            x:Key="SettingsCardHeader"
            TargetType="TextBlock">

            <Setter
                Property="FontSize"
                Value="14" />

            <Setter
                Property="FontWeight"
                Value="SemiBold" />

        </Style>

    </Page.Resources>

    <Grid
        RowDefinitions="Auto,*,Auto">

        <SelectorBar
            Grid.Row="0"
            x:Name="TabBar"
            FontSize="13"
            Margin="24,12,24,0"
            SelectionChanged="TabBarSelectionChanged">

            <SelectorBarItem
                Tag="Traffic"
                Text="Traffic" />

            <SelectorBarItem
                Tag="Device"
                Text="Devices" />

            <SelectorBarItem
                Tag="Other"
                Text="Other" />

        </SelectorBar>

        <ScrollViewer
            Grid.Row="1"
            x:Name="TrafficPanel"
            Margin="0,8,0,0">

            <StackPanel
                HorizontalAlignment="Center"
                MaxWidth="480"
                Padding="24,16,24,16"
                Spacing="12">

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Sampling" />

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Scan Interval (seconds)" />

                            <NumberBox
                                Minimum="1"
                                Maximum="60"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="TrafficIntervalSecondsBoxValueChanged"
                                Value="{x:Bind ViewModel.TrafficIntervalSeconds, Mode=TwoWay}" />

                        </StackPanel>

                        <StackPanel
                            Spacing="4">

                            <ToggleSwitch
                                Header="Chart smooth scrolling"
                                IsOn="{x:Bind ViewModel.ChartSmoothScrolling, Mode=TwoWay}" />

                            <TextBlock
                                Text="When on, the Internet and Local traffic charts scroll continuously. When off, they redraw in place on each update (classic style, lighter on CPU)."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                        </StackPanel>

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Speed units" />

                            <ComboBox
                                HorizontalAlignment="Stretch"
                                SelectedIndex="{x:Bind ViewModel.RateUnitModeIndex, Mode=TwoWay}">

                                <ComboBoxItem>

                                    <TextBlock>

                                        <Run
                                            Text="Both —" />

                                        <Run
                                            Text="MegaBits (Mb/s)"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DigestAccentTealBrush}" />

                                        <Run
                                            Text="·" />

                                        <Run
                                            Text="MegaBytes (MB/s)"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DigestAccentBlueBrush}" />

                                    </TextBlock>

                                </ComboBoxItem>

                                <ComboBoxItem>

                                    <TextBlock>

                                        <Run
                                            Text="MegaBits"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DigestAccentTealBrush}" />

                                        <Run
                                            Text="per second" />

                                        <Run
                                            Text="(Mb/s)"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DigestAccentTealBrush}" />

                                    </TextBlock>

                                </ComboBoxItem>

                                <ComboBoxItem>

                                    <TextBlock>

                                        <Run
                                            Text="MegaBytes"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DigestAccentBlueBrush}" />

                                        <Run
                                            Text="per second" />

                                        <Run
                                            Text="(MB/s)"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DigestAccentBlueBrush}" />

                                    </TextBlock>

                                </ComboBoxItem>

                            </ComboBox>

                            <TextBlock
                                Text="How live speeds are shown across the app — traffic rate badges, chart axes, the Speed Test page, digest reports and toasts. CSV exports always include both units."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Speed test" />

                        <StackPanel
                            Spacing="4">

                            <ToggleSwitch
                                Header="Run periodic speed tests (hourly)"
                                IsOn="{x:Bind ViewModel.SpeedTestEnabled, Mode=TwoWay}" />

                            <TextBlock
                                Text="Once an hour, measures download and upload throughput, latency and jitter using Cloudflare's free speed test service (speed.cloudflare.com) — no account or API key is required. The nearest Cloudflare data centre is used as the server. Use Run Speed Test on the Speed Test page for an immediate test."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Text="⚠ Warning: to measure accurately, each test saturates your line with parallel connections and uses roughly 750 MB, about 18 GB/day, for an hourly test. Turn this off if you're on a metered or capped connection."
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Data retention" />

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Purge traffic older than (days)" />

                            <NumberBox
                                Minimum="0"
                                Maximum="7"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.TrafficPurgeDays, Mode=TwoWay}" />

                            <TextBlock
                                Text="Traffic history is kept for a maximum of 7 days. Set to 0 to disable automatic purging."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">

                            <Button
                                Content="Purge Now"
                                Click="PurgeTrafficNowClick" />

                            <TextBlock
                                VerticalAlignment="Center"
                                Opacity="0.65"
                                FontSize="12"
                                Text="{x:Bind ViewModel.TrafficPurgeStatus, Mode=OneWay}" />

                        </StackPanel>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <ScrollViewer
            Grid.Row="1"
            x:Name="DevicePanel"
            Visibility="Collapsed"
            Margin="0,8,0,0">

            <StackPanel
                HorizontalAlignment="Center"
                Width="480"
                Padding="24,16,24,16"
                Spacing="12">

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Network range" />

                        <StackPanel
                            Spacing="4">

                            <ToggleSwitch
                                Header="Auto-detect subnet"
                                IsOn="{x:Bind ViewModel.AutoDetectSubnet, Mode=TwoWay}" />

                            <TextBlock
                                Text="When on, the subnet follows your active network connection — moving to a different network (e.g. taking a laptop elsewhere) is picked up automatically and triggers a scan. Turn off to scan a fixed subnet of your choice."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                        </StackPanel>

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Subnet Base (e.g. 192.168.1)" />

                            <TextBox
                                IsEnabled="{x:Bind ViewModel.SubnetBaseEditable, Mode=OneWay}"
                                Text="{x:Bind ViewModel.SubnetBase, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        </StackPanel>

                        <Grid
                            ColumnDefinitions="*,Auto,*"
                            ColumnSpacing="8">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="4">

                                <TextBlock
                                    Text="Start Host" />

                                <NumberBox
                                    Minimum="1"
                                    Maximum="254"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind ViewModel.StartHost, Mode=TwoWay}" />

                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                Text="–"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,8" />

                            <StackPanel
                                Grid.Column="2"
                                Spacing="4">

                                <TextBlock
                                    Text="End Host" />

                                <NumberBox
                                    Minimum="1"
                                    Maximum="254"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind ViewModel.EndHost, Mode=TwoWay}" />

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Scan settings" />

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Scan Interval (minutes)" />

                            <NumberBox
                                Minimum="1"
                                Maximum="60"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.IntervalMinutes, Mode=TwoWay}" />

                        </StackPanel>

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Ping Timeout (ms)" />

                            <NumberBox
                                Minimum="100"
                                Maximum="5000"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.PingTimeoutMs, Mode=TwoWay}" />

                        </StackPanel>

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Max Parallel Pings" />

                            <NumberBox
                                Minimum="10"
                                Maximum="254"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.MaxParallelPings, Mode=TwoWay}" />

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Data retention" />

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Purge history older than (days)" />

                            <NumberBox
                                Minimum="0"
                                Maximum="3650"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.HistoryPurgeDays, Mode=TwoWay}" />

                            <TextBlock
                                Text="Set to 0 to disable automatic purging."
                                FontSize="12"
                                Opacity="0.65" />

                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">

                            <Button
                                Content="Purge Now"
                                Click="PurgeNowClick" />

                            <TextBlock
                                VerticalAlignment="Center"
                                Opacity="0.65"
                                FontSize="12"
                                Text="{x:Bind ViewModel.PurgeStatus, Mode=OneWay}" />

                        </StackPanel>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <ScrollViewer
            Grid.Row="1"
            x:Name="OtherPanel"
            Visibility="Collapsed"
            Margin="0,8,0,0">

            <StackPanel
                HorizontalAlignment="Center"
                Width="480"
                Padding="24,16,24,16"
                Spacing="12">

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Startup" />

                        <StackPanel
                            Spacing="4">

                            <ToggleSwitch
                                Header="Run at Windows startup"
                                IsOn="{x:Bind ViewModel.RunAtStartup, Mode=TwoWay}" />

                            <TextBlock
                                Text="Starts Umnatha Network Monitor automatically when you sign in, with the elevated permissions needed for per-process traffic — without a UAC prompt (uses a Windows scheduled task)."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Notifications" />

                        <ToggleSwitch
                            Header="Show Toast Notifications"
                            IsOn="{x:Bind ViewModel.ShowToasts, Mode=TwoWay}" />

                        <CheckBox
                            Content="Unapproved devices only"
                            Margin="8,0,0,0"
                            IsChecked="{x:Bind ViewModel.UnapprovedOnlyToasts, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.ShowToasts, Mode=OneWay}" />

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Software updates" />

                        <ToggleSwitch
                            Header="Automatically check for updates"
                            IsOn="{x:Bind ViewModel.AutoCheckForUpdates, Mode=TwoWay}" />

                        <Button
                            Content="Check for updates"
                            HorizontalAlignment="Left"
                            IsEnabled="{x:Bind UpdateViewModel.IsNotBusy, Mode=OneWay}"
                            Command="{x:Bind UpdateViewModel.CheckNowCommand}" />

                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind UpdateViewModel.IsBannerOpen, Mode=OneWay}"
                            Severity="{x:Bind UpdateViewModel.Severity, Mode=OneWay}"
                            Message="{x:Bind UpdateViewModel.Message, Mode=OneWay}" />

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Daily digest" />

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Daily digest generation time (hour, 0–23)" />

                            <NumberBox
                                Minimum="0"
                                Maximum="23"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.DigestGenerationHour, Mode=TwoWay}" />

                        </StackPanel>

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Keep digests for (days)" />

                            <NumberBox
                                Minimum="1"
                                Maximum="3650"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.DigestPurgeDays, Mode=TwoWay}" />

                        </StackPanel>

                        <ToggleSwitch
                            Header="Notify when a daily digest is ready"
                            IsOn="{x:Bind ViewModel.DigestNotify, Mode=TwoWay}" />

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Diagnostics" />

                        <StackPanel
                            Spacing="4">

                            <ToggleSwitch
                                Header="Enable diagnostic logging"
                                IsEnabled="{x:Bind ViewModel.LoggingToggleEnabled}"
                                IsOn="{x:Bind ViewModel.EnableLoggingDisplay, Mode=TwoWay}" />

                            <TextBlock
                                Text="Always on in Debug builds — this switch is disabled and logging cannot be turned off while debugging."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.LoggingForced, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <TextBlock
                                Text="Writes app events (start/stop, version, scans) and unexpected errors to a daily log file under the app data Logs folder. No device or network details are recorded. If you have any problems, please open a GitHub issue and share these logs there."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                            <HyperlinkButton
                                Content="Open logs folder"
                                Padding="0,4,0,0"
                                Click="OpenLogsFolderClick" />

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Data folder" />

                        <TextBlock
                            Text="Umnatha Network Monitor keeps its database, your settings and its logs in your local app data folder. These files stay on this PC, persist between sessions, and are never shared."
                            FontSize="12"
                            Opacity="0.65"
                            TextWrapping="Wrap" />

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="16"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                            RowSpacing="6">

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="File / folder"
                                FontSize="12"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="Contents"
                                FontSize="12"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="networkmonitor.db"
                                FontFamily="Consolas"
                                FontSize="12" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="Main database — device list, scan history, connect/disconnect events, traffic, daily digests and speed-test results."
                                FontSize="12"
                                Opacity="0.8"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="networkmonitor.db-wal/-shm"
                                FontFamily="Consolas"
                                FontSize="12" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="SQLite write-ahead log and shared-memory files — temporary working files for the database. They appear while the app runs, do not delete."
                                FontSize="12"
                                Opacity="0.8"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Text="settings.json"
                                FontFamily="Consolas"
                                FontSize="12" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Text="Your saved settings from all Settings pages."
                                FontSize="12"
                                Opacity="0.8"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Text="sort-*.json"
                                FontFamily="Consolas"
                                FontSize="12" />

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Text="Saved column sort order for each list page."
                                FontSize="12"
                                Opacity="0.8"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="0"
                                Text="\Logs"
                                FontFamily="Consolas"
                                FontSize="12" />

                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                Text="Daily diagnostic log files (Log-yyyymmdd.txt)."
                                FontSize="12"
                                Opacity="0.8"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="0"
                                Text="\Backups"
                                FontFamily="Consolas"
                                FontSize="12" />

                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="1"
                                Text="Automatic database backups and approved-device CSV backups."
                                FontSize="12"
                                Opacity="0.8"
                                TextWrapping="Wrap" />

                        </Grid>

                        <HyperlinkButton
                            Content="Open data folder"
                            Padding="0,4,0,0"
                            Click="OpenDataFolderClick" />

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="24,12,24,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="12"
                MaxWidth="480">

                <Button
                    Content="About"
                    Click="AboutClick" />

                <Button
                    Content="Release Notes"
                    Click="ReleaseNotesClick" />

            </StackPanel>

        </Border>

        <ContentDialog
            x:Name="AboutDialog"
            CloseButtonText="Close"
            DefaultButton="Close">

            <StackPanel
                Spacing="4">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition
                            Width="*" />

                        <ColumnDefinition
                            Width="Auto" />

                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="Umnatha Network Monitor"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold" />

                    <Image
                        x:Name="AboutLogo"
                        Grid.Column="1"
                        Width="80"
                        Height="80"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />

                </Grid>

                <TextBlock
                    x:Name="VersionText" />

                <TextBlock
                    Text="© Jazzz Software 2026" />

                <TextBlock
                    Text="jazzzsoftware@outlook.com" />

                <RichTextBlock
                    Margin="0,20,0,0"
                    TextWrapping="Wrap">

                    <Paragraph>
                        The name
                        <InlineUIContainer>

                            <Border
                                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                CornerRadius="6"
                                Margin="4,0,4,0"
                                Padding="6,2,6,2">

                                <Border.RenderTransform>

                                    <TranslateTransform
                                        Y="6" />

                                </Border.RenderTransform>

                                <TextBlock
                                    Text="Umnatha"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                            </Border>

                        </InlineUIContainer> comes from isiXhosa, one of South Africa's indigenous languages, where it means 'Net'. (Pronounced oom-NAH-tah.)
                    </Paragraph>

                </RichTextBlock>

            </StackPanel>

        </ContentDialog>

        <ContentDialog
            x:Name="ReleaseNotesDialog"
            Title="Release Notes"
            CloseButtonText="Close"
            DefaultButton="Close">

            <ScrollViewer
                MaxHeight="440">

                <StackPanel
                    Spacing="8">

                    <TextBlock
                        x:Name="ReleaseNotesVersion"
                        FontWeight="SemiBold"
                        FontSize="16" />

                    <TextBlock
                        Text="• New: Automatic updates. The app now checks GitHub for a newer version when it starts and once a day after that. When one is available a banner appears at the top of the window — click Update now and the app downloads it, installs it and restarts itself on the new version, or click Later to leave it for another time."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Every download is checked against a SHA-256 checksum published with the release before anything is installed, so a corrupted or tampered download is never run."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Update settings. Automatic checking can be switched off in Settings, which also has a Check for updates button for checking on demand — it tells you either that an update is available or that you're already on the latest version."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="Version 0.0.8"
                        FontWeight="SemiBold"
                        FontSize="16"
                        Margin="0,12,0,0" />

                    <TextBlock
                        Text="• New: Speed units setting. Choose how network speeds are shown — megabits (Mb/s), megabytes (MB/s), or both — from Settings."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Automatic subnet detection. The app now works out your network's address range on its own and re-checks it whenever your connection changes (with a notification), so scans always cover the right range."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Updated device-vendor database. Refreshed to the latest IEEE registry, so more devices show the correct manufacturer."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Minor: renamed the Settings 'Device' tab to 'Devices', plus small fixes."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="Version 0.0.7"
                        FontWeight="SemiBold"
                        FontSize="16"
                        Margin="0,12,0,0" />

                    <TextBlock
                        Text="• New: Local network traffic. The Traffic page now has a Local tab showing which apps on this PC are talking to other devices on your network. Switch between By app and By device — the By device view makes a big transfer obvious, like a NAS backup climbing as a large upload. (Windows performs file-share/SMB copies in the kernel, so they show under System, tagged SMB, rather than the app that started them.)"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Live speed badge. While data is actively moving, the busy app or device shows a live throughput badge (e.g. 141 Mb/s · 18 MB/s) on both the Internet and Local tabs."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Fixed: downloads were being undercounted. A kernel-attribution bug caused most incoming (download) traffic — including reads from network shares, such as a NAS backup verify — to be dropped. Download figures are now accurate."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Cleaner Local view. Constant device-discovery chatter (from browsers and antivirus scanning the network) is folded into one collapsible row, and phantom entries for broadcast addresses and scanned-but-empty IPs are filtered out, so you see your real devices."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• More accurate speed tests. The speed test now uses parallel connections and measures sustained throughput, so results match speedtest.net and Cloudflare instead of reading low on fast connections. This uses more data per test — see the note next to the Speed Test setting."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Speed tests in reports. A failed (0-result) speed test now still appears in the charts and reports so you can see when the internet was down, and the daily-digest speed chart now matches the Speed Test page."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Consistent units. All sizes and speeds across the app — traffic totals, live speed badges, charts and the Speed Test — use decimal units (KB/MB/GB, ÷1000), matching your ISP and speedtest.net."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="Version 0.0.6"
                        FontWeight="SemiBold"
                        FontSize="16"
                        Margin="0,12,0,0" />

                    <TextBlock
                        Text="• Automatic device naming (mDNS/Bonjour). Devices that previously showed only an IP address — phones, and many Apple, Google and smart-home devices — now appear with a friendly name. This especially helps modern devices that use randomised MAC addresses, where vendor and hostname lookups come up blank."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• New Model column on the Devices list shows the hardware model for devices that publish it (e.g. Apple gear)."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Names with spaces and special characters display correctly, and meaningless internal identifiers are ignored, so you get a clean, readable name."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• The discovery runs during every scan with no noticeable slowdown, stays entirely on your machine, and never overwrites a friendly name you've set."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="Version 0.0.5"
                        FontWeight="SemiBold"
                        FontSize="16"
                        Margin="0,12,0,0" />

                    <TextBlock
                        Text="• Speed tests now run at the top of each hour and use larger 50 MB transfers with more latency samples, for more accurate results."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Speed-test latency is now measured the same way as Cloudflare's own web test, so the figure is accurate rather than inflated."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Speed-test times are now shown in your local time."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Throughput is now labelled Download/Upload (renamed from Received/Sent) and shown in both Mb/s and MB/s, colour-coded — on the Speed Test page and in the daily digest."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• The daily digest lists the most recent speed tests first."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• All charts now have labelled value axes (with units), an axis line and gridlines for easier reading."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• The Speed Test chart now displays correctly right after the very first test."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Scan and speed-test completions now also raise Windows toast notifications (when toasts are enabled); the speed-test toast shows both Mb/s and MB/s."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• New 'Data Folder' section in Settings shows what is stored on your PC, with a link to open the folder."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• New 'Release Notes' button in Settings (this screen)."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• When set to run at Windows startup, the app now starts minimised to the system tray."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• The app now remembers whether its window was maximised."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Device-history CSV files can no longer be imported as approved devices, preventing accidental imports."
                        TextWrapping="Wrap" />

