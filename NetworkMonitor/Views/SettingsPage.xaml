                <RichTextBlock
                    Margin="0,20,0,0"
                    TextWrapping="Wrap">

                    <Paragraph>
                        The name
                        <InlineUIContainer>

                            <Border
                                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
