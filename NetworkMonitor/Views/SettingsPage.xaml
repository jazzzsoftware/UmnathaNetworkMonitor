            </StackPanel>

        </Border>

        <ContentDialog
            x:Name="AboutDialog"
            CloseButtonText="Close"
            DefaultButton="Close">

            <StackPanel
                Spacing="4">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition
                            Width="*" />

                        <ColumnDefinition
                            Width="Auto" />

                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="Umnatha Network Monitor"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold" />

                    <Image
                        x:Name="AboutLogo"
                        Grid.Column="1"
                        Width="80"
                        Height="80"
                        HorizontalAlignment="Right"
