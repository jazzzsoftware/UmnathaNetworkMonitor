<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="NetworkMonitor.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>

        <Style
            x:Key="SettingsCard"
            TargetType="Border">

            <Setter
                Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />

            <Setter
                Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefaultBrush}" />

            <Setter
                Property="BorderThickness"
                Value="1" />

            <Setter
                Property="CornerRadius"
                Value="6" />

            <Setter
                Property="Padding"
                Value="16" />

        </Style>

        <Style
            x:Key="SettingsCardHeader"
            TargetType="TextBlock">

            <Setter
                Property="FontSize"
                Value="14" />

            <Setter
                Property="FontWeight"
                Value="SemiBold" />

        </Style>

    </Page.Resources>

    <Grid
        RowDefinitions="Auto,*,Auto">

        <SelectorBar
            Grid.Row="0"
            x:Name="TabBar"
            FontSize="13"
            Margin="24,12,24,0"
            SelectionChanged="TabBarSelectionChanged">

            <SelectorBarItem
                Tag="Traffic"
                Text="Traffic" />

            <SelectorBarItem
                Tag="Device"
                Text="Device" />

            <SelectorBarItem
                Tag="Other"
                Text="Other" />

        </SelectorBar>

        <ScrollViewer
            Grid.Row="1"
            x:Name="TrafficPanel"
            Margin="0,8,0,0">

            <StackPanel
                HorizontalAlignment="Center"
                MaxWidth="480"
                Padding="24,16,24,16"
                Spacing="12">

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Sampling" />

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Scan Interval (seconds)" />

                            <NumberBox
                                Minimum="1"
                                Maximum="60"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="TrafficIntervalSecondsBoxValueChanged"
                                Value="{x:Bind ViewModel.TrafficIntervalSeconds, Mode=TwoWay}" />

                        </StackPanel>

                        <StackPanel
                            Spacing="4">

                            <ToggleSwitch
                                Header="Chart smooth scrolling"
                                IsOn="{x:Bind ViewModel.ChartSmoothScrolling, Mode=TwoWay}" />

                            <TextBlock
                                Text="When on, the Traffic chart scrolls continuously. When off, it redraws in place on each update (classic style, lighter on CPU)."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Speed test" />

                        <StackPanel
                            Spacing="4">

                            <ToggleSwitch
                                Header="Run periodic speed tests (hourly)"
                                IsOn="{x:Bind ViewModel.SpeedTestEnabled, Mode=TwoWay}" />

                            <TextBlock
                                Text="Once an hour, measures download and upload throughput, latency and jitter using Cloudflare's free speed test service (speed.cloudflare.com) — no account or API key is required. The nearest Cloudflare data centre is used as the server. Use Run Speed Test on the Speed Test page for an immediate test."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Data retention" />

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Purge traffic older than (days)" />

                            <NumberBox
                                Minimum="0"
                                Maximum="7"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.TrafficPurgeDays, Mode=TwoWay}" />

                            <TextBlock
                                Text="Traffic history is kept for a maximum of 7 days. Set to 0 to disable automatic purging."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">

                            <Button
                                Content="Purge Now"
                                Click="PurgeTrafficNowClick" />

                            <TextBlock
                                VerticalAlignment="Center"
                                Opacity="0.65"
                                FontSize="12"
                                Text="{x:Bind ViewModel.TrafficPurgeStatus, Mode=OneWay}" />

                        </StackPanel>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <ScrollViewer
            Grid.Row="1"
            x:Name="DevicePanel"
            Visibility="Collapsed"
            Margin="0,8,0,0">

            <StackPanel
                HorizontalAlignment="Center"
                Width="480"
                Padding="24,16,24,16"
                Spacing="12">

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Network range" />

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Subnet Base (e.g. 192.168.1)" />

                            <TextBox
                                Text="{x:Bind ViewModel.SubnetBase, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        </StackPanel>

                        <Grid
                            ColumnDefinitions="*,Auto,*"
                            ColumnSpacing="8">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="4">

                                <TextBlock
                                    Text="Start Host" />

                                <NumberBox
                                    Minimum="1"
                                    Maximum="254"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind ViewModel.StartHost, Mode=TwoWay}" />

                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                Text="–"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,8" />

                            <StackPanel
                                Grid.Column="2"
                                Spacing="4">

                                <TextBlock
                                    Text="End Host" />

                                <NumberBox
                                    Minimum="1"
                                    Maximum="254"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind ViewModel.EndHost, Mode=TwoWay}" />

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Scan settings" />

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Scan Interval (minutes)" />

                            <NumberBox
                                Minimum="1"
                                Maximum="60"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.IntervalMinutes, Mode=TwoWay}" />

                        </StackPanel>

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Ping Timeout (ms)" />

                            <NumberBox
                                Minimum="100"
                                Maximum="5000"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.PingTimeoutMs, Mode=TwoWay}" />

                        </StackPanel>

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Max Parallel Pings" />

                            <NumberBox
                                Minimum="10"
                                Maximum="254"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.MaxParallelPings, Mode=TwoWay}" />

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Data retention" />

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Purge history older than (days)" />

                            <NumberBox
                                Minimum="0"
                                Maximum="3650"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.HistoryPurgeDays, Mode=TwoWay}" />

                            <TextBlock
                                Text="Set to 0 to disable automatic purging."
                                FontSize="12"
                                Opacity="0.65" />

                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">

                            <Button
                                Content="Purge Now"
                                Click="PurgeNowClick" />

                            <TextBlock
                                VerticalAlignment="Center"
                                Opacity="0.65"
                                FontSize="12"
                                Text="{x:Bind ViewModel.PurgeStatus, Mode=OneWay}" />

                        </StackPanel>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <ScrollViewer
            Grid.Row="1"
            x:Name="OtherPanel"
            Visibility="Collapsed"
            Margin="0,8,0,0">

            <StackPanel
                HorizontalAlignment="Center"
                Width="480"
                Padding="24,16,24,16"
                Spacing="12">

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Startup" />

                        <StackPanel
                            Spacing="4">

                            <ToggleSwitch
                                Header="Run at Windows startup"
                                IsOn="{x:Bind ViewModel.RunAtStartup, Mode=TwoWay}" />

                            <TextBlock
                                Text="Starts Umnatha Network Monitor automatically when you sign in, with the elevated permissions needed for per-process traffic — without a UAC prompt (uses a Windows scheduled task)."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Notifications" />

                        <ToggleSwitch
                            Header="Show Toast Notifications"
                            IsOn="{x:Bind ViewModel.ShowToasts, Mode=TwoWay}" />

                        <CheckBox
                            Content="Unapproved devices only"
                            Margin="8,0,0,0"
                            IsChecked="{x:Bind ViewModel.UnapprovedOnlyToasts, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.ShowToasts, Mode=OneWay}" />

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Daily digest" />

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Daily digest generation time (hour, 0–23)" />

                            <NumberBox
                                Minimum="0"
                                Maximum="23"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.DigestGenerationHour, Mode=TwoWay}" />

                        </StackPanel>

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Keep digests for (days)" />

                            <NumberBox
                                Minimum="1"
                                Maximum="3650"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.DigestPurgeDays, Mode=TwoWay}" />

                        </StackPanel>

                        <ToggleSwitch
                            Header="Notify when a daily digest is ready"
                            IsOn="{x:Bind ViewModel.DigestNotify, Mode=TwoWay}" />

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Diagnostics" />

                        <StackPanel
                            Spacing="4">

                            <ToggleSwitch
                                Header="Enable diagnostic logging"
                                IsOn="{x:Bind ViewModel.EnableLogging, Mode=TwoWay}" />

                            <TextBlock
                                Text="Writes app events (start/stop, version, scans) and unexpected errors to a daily log file under the app data Logs folder. No device or network details are recorded. If you have any problems, please share these logs with me, jazzzsoftware@outlook.com, to help diagnose problems."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                            <HyperlinkButton
                                Content="Open logs folder"
                                Padding="0,4,0,0"
                                Click="OpenLogsFolderClick" />

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Data folder" />

                        <TextBlock
                            Text="Umnatha Network Monitor keeps its database, your settings and its logs in your local app data folder. These files stay on this PC, persist between sessions, and are never shared."
                            FontSize="12"
                            Opacity="0.65"
                            TextWrapping="Wrap" />

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="16"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                            RowSpacing="6">

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="File / folder"
                                FontSize="12"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="Contents"
                                FontSize="12"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="networkmonitor.db"
                                FontFamily="Consolas"
                                FontSize="12" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="Main database — device list, scan history, connect/disconnect events, traffic, daily digests and speed-test results."
                                FontSize="12"
                                Opacity="0.8"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="networkmonitor.db-wal/-shm"
                                FontFamily="Consolas"
                                FontSize="12" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="SQLite write-ahead log and shared-memory files — temporary working files for the database. They appear while the app runs and are safe to leave in place."
                                FontSize="12"
                                Opacity="0.8"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Text="settings.json"
                                FontFamily="Consolas"
                                FontSize="12" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Text="Your saved settings from this page."
                                FontSize="12"
                                Opacity="0.8"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Text="sort-*.json"
                                FontFamily="Consolas"
                                FontSize="12" />

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Text="Saved column sort order for each list page."
                                FontSize="12"
                                Opacity="0.8"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="0"
                                Text="\Logs"
                                FontFamily="Consolas"
                                FontSize="12" />

                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                Text="Daily diagnostic log files (Log-yyyymmdd.txt)."
                                FontSize="12"
                                Opacity="0.8"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="0"
                                Text="\Backups"
                                FontFamily="Consolas"
                                FontSize="12" />

                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="1"
                                Text="Automatic database backups and approved-device CSV backups."
                                FontSize="12"
                                Opacity="0.8"
                                TextWrapping="Wrap" />

                        </Grid>

                        <HyperlinkButton
                            Content="Open data folder"
                            Padding="0,4,0,0"
                            Click="OpenDataFolderClick" />

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="24,12,24,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="12"
                MaxWidth="480">

                <Button
                    Content="About"
                    Click="AboutClick" />

                <Button
                    Content="Release Notes"
                    Click="ReleaseNotesClick" />

            </StackPanel>

        </Border>

        <ContentDialog
            x:Name="AboutDialog"
            CloseButtonText="Close"
            DefaultButton="Close">

            <StackPanel
                Spacing="4">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition
                            Width="*" />

                        <ColumnDefinition
                            Width="Auto" />

                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="Umnatha Network Monitor"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold" />

                    <Image
                        x:Name="AboutLogo"
                        Grid.Column="1"
                        Width="80"
                        Height="80"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />

                </Grid>

                <TextBlock
                    x:Name="VersionText" />

                <TextBlock
                    Text="© Jazzz Software 2026" />

                <TextBlock
                    Text="jazzzsoftware@outlook.com" />

                <RichTextBlock
                    Margin="0,20,0,0"
                    TextWrapping="Wrap">

                    <Paragraph>
                        The name
                        <InlineUIContainer>

                            <Border
                                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                CornerRadius="6"
                                Margin="4,0,4,0"
                                Padding="6,2,6,2">

                                <Border.RenderTransform>

                                    <TranslateTransform
                                        Y="6" />

                                </Border.RenderTransform>

                                <TextBlock
                                    Text="Umnatha"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                            </Border>

                        </InlineUIContainer> comes from isiXhosa, one of South Africa's indigenous languages, where it means 'Net'. (Pronounced oom-NAH-tah.)
                    </Paragraph>

                </RichTextBlock>

            </StackPanel>

        </ContentDialog>

        <ContentDialog
            x:Name="ReleaseNotesDialog"
            Title="Release Notes"
            CloseButtonText="Close"
            DefaultButton="Close">

            <ScrollViewer
                MaxHeight="440">

                <StackPanel
                    Spacing="8">

                    <TextBlock
                        x:Name="ReleaseNotesVersion"
                        FontWeight="SemiBold"
                        FontSize="16" />

                    <TextBlock
                        Text="What's new in this build:"
                        Opacity="0.7" />

                    <TextBlock
                        Text="• Automatic device naming (mDNS/Bonjour). Devices that previously showed only an IP address — phones, and many Apple, Google and smart-home devices — now appear with a friendly name. This especially helps modern devices that use randomised MAC addresses, where vendor and hostname lookups come up blank."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• New Model column on the Devices list shows the hardware model for devices that publish it (e.g. Apple gear)."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Names with spaces and special characters display correctly, and meaningless internal identifiers are ignored, so you get a clean, readable name."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• The discovery runs during every scan with no noticeable slowdown, stays entirely on your machine, and never overwrites a friendly name you've set."
                        TextWrapping="Wrap" />

                </StackPanel>

            </ScrollViewer>

        </ContentDialog>

    </Grid>

</Page>
