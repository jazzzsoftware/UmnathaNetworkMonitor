                                Margin="4,0,4,0"
                                Padding="6,2,6,2">

                                <Border.RenderTransform>

                                    <TranslateTransform
                                        Y="6" />

                                </Border.RenderTransform>

                                <TextBlock
                                    Text="Umnatha"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                            </Border>

                        </InlineUIContainer> comes from isiXhosa, one of South Africa's indigenous languages, where it means 'Net'. (Pronounced oom-NAH-tah.)
                    </Paragraph>

                </RichTextBlock>

            </StackPanel>

        </ContentDialog>

        <ContentDialog
            x:Name="ReleaseNotesDialog"
            Title="Release Notes"
            CloseButtonText="Close"
            DefaultButton="Close">

            <ScrollViewer
                MaxHeight="440">

                <StackPanel
                    Spacing="8">

                    <TextBlock
                        Text="v0.0.13"
                        FontWeight="SemiBold"
                        FontSize="16" />

                    <TextBlock
                        Text="• New: Automated UI testing. Nine phases drive the real app end to end, including a full uninstall, install and update cycle. It is developer tooling and is not part of what you install. Every fix below is something it found."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• New: Charts, grids and device notes are now readable by a screen reader. Each chart announces its range and trend instead of an empty graphic."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Changed: The mini graph's opacity slider ticks are labelled with percentages."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Fixed: The app could hang on startup after being killed. A traffic session left behind by the previous run blocked the next launch; it is now found and stopped first."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Fixed: Purge Now deleted nothing and always reported 'Purged 0 entries'. It now runs the same retention sweep the app runs daily."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Fixed: An antivirus scan could discard a settings save while the app still showed 'Settings saved'. The save is now retried, and confirmed only once it reaches disk."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Fixed: The main window opened nearly full screen on a first run, and a size saved on a large monitor reopened off the edge of a smaller one."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Under the hood: A redirectable data folder and stable control identifiers, both added so the suite can drive a real app without touching your data."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Note: Nothing here changes the database. Your history carries across untouched."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="v0.0.12"
                        FontWeight="SemiBold"
                        FontSize="16"
                        Margin="0,12,0,0" />

                    <TextBlock
                        Text="• New: Chart colour schemes. Settings has a new Theme tab with five schemes — Classic, Horizon, Aurora, Ember and Ocean — plus Custom, where you set each colour yourself by clicking its swatch. The choice applies straight away across the Internet, Local and Speed test charts, the mini graph, the coloured Download and Upload figures in the grids, and the chart legends. Each colour is adjusted automatically to stay readable on both the dark and light card backgrounds."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• New: A preview on the Theme tab draws sample charts in the scheme you have picked, so you can see every colour in context — including the hover line, which on a real chart only appears while you are pointing at it."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• New: Clicking a Windows notification now opens the app at the part it is about. An unrecognised device takes you to the Unapproved list, a device you already know to its history, a finished scan or network change to the device list, a speed test to the Speed test tab, and a daily digest to Reports. The window is restored and brought to the front first, so it works from the tray or minimised."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Changed: The mini graph's shape is now an Orientation setting offering Vertical and Horizontal, in place of the old 'Horizontal strip' on/off switch — the two shapes are equal choices, and the wording now matches the widget's right-click menu."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Changed: The chart hover line uses your scheme's colour. Previously it was grey while you hovered and only picked up the colour once you clicked a point."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Changed: The app does noticeably less work while running. The mini graph no longer redraws detail finer than the screen can show and stops redrawing while nothing is moving; the Internet app list updates figures in place instead of rebuilding every row; device history loads without duplicating a device per event; and the live charts reuse their working memory instead of reallocating several times a second."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Changed: The mini graph now obeys the smooth-scrolling setting. It carries five times the geometry of the full-page charts and runs all day, and it was the one chart you could not turn down."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Changed: A very slow link now reads '&lt;0.1' instead of '0' in the mini graph. A link limping along used to display exactly like one that was down. A genuinely idle link still reads '0'."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Fixed: A typed retention value could be silently discarded. Typing a new number and then clicking blank space left the box showing a value that had never reached your settings, with no 'Settings saved' confirmation. Typed values now commit when focus leaves the box."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Fixed: Purge Now at 0 days would have deleted your entire history. 0 means 'retention disabled' everywhere else in the app; the purge computed a cutoff of now instead. It now refuses."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Fixed: The horizontal strip grew about 7 pixels taller on every orientation switch, climbing until it hit its ceiling."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Fixed: Exiting from the tray icon could raise a 'CancellationTokenSource has been disposed' error and abandon the rest of shutdown."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Fixed: A corrupted settings file could leave the app unable to start, fixable only by finding and deleting the file by hand. Concurrent writes can no longer truncate it, and a malformed file no longer stops startup."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Fixed: The live mini chart's rightmost slice read about half the true rate during a sustained transfer — a permanent dip at the point the eye goes to."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Note: The daily digest report keeps its own fixed colours and is not affected by the schemes."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Note: If you have not changed anything, the default chart colours are very slightly lighter than before — the same readability adjustment applied to the default scheme."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Note: The database now upgrades itself through versioned migrations, so future updates can change its structure without losing your device and traffic history."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="v0.0.11"
                        FontWeight="SemiBold"
                        FontSize="16"
                        Margin="0,12,0,0" />

                    <TextBlock
                        Text="• New: Horizontal mini graph. The mini graph can now be laid out as a short, wide strip instead of a panel — short enough to sit over the taskbar if you drag it there. Its width follows whichever sections you have switched on, and you set its height by dragging its top or bottom edge. Switch between the two layouts from the widget's right-click menu or Settings; each remembers its own position on screen."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• New: Show or hide the mini graph's window border, from the widget's right-click menu or Settings. The border is shown by default; hiding it needs Windows 11, as Windows 10 always shows it."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• The horizontal strip shortens the speed test line to the rates and ping so it does not crowd out the charts, and centres the speed and unknown-device readings in their cells."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Fixed the mini graph forgetting where you left it if you had dragged it slightly past the edge of the screen — it would reappear in the corner of the desktop instead. This affected the floating panel as well as the new strip."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Known issue: after your PC resumes from sleep, Windows can draw the taskbar over the mini graph and over the tray menu, even though both are correctly positioned above it. This is a Windows display problem rather than a fault in the app — the tray menu is affected the same way. Restarting Umnatha Network Monitor does not clear it; it takes a Windows restart."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="v0.0.10"
                        FontWeight="SemiBold"
                        FontSize="16"
                        Margin="0,12,0,0" />

                    <TextBlock
                        Text="• New: Floating mini graph. A small always-on-top window showing live Internet and local network activity, your latest speed test and any unknown devices. Switch it on from the tray icon, the toolbar or Settings. It fades when you're not using it and turns solid when you hover, and double-clicking a section opens the matching page."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• New: Online only filter. The Devices list has an 'Online only' toggle that hides devices which have gone offline. Your choice is remembered between sessions."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Traffic chart axes now scale on a 1-2-5-10 ladder, so the labels read as round numbers."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Fixed live chart peaks that could read above your connection's physical line rate."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Daily digest: preview charts render at their displayed size so they stay sharp, and a missed digest is caught up when the app starts rather than waiting for the next scheduled run."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Update checks: an unreachable update server is now logged as a message rather than reported as a failure, checks are bounded to 20 seconds, and the Settings 'Check for updates' button no longer closes its own result banner."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• In-app notifications are centred on the page content instead of the window."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Fixed a false 'checkpoint failed' and a false speed-test timeout reported during shutdown."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="v0.0.9"
                        FontWeight="SemiBold"
                        FontSize="16"
                        Margin="0,12,0,0" />

                    <TextBlock
                        Text="• New: Automatic updates. The app now checks GitHub for a newer version when it starts and once a day after that. When one is available a banner appears at the top of the window — click Update now and the app downloads it, installs it and restarts itself on the new version, or click Later to leave it for another time."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Every download is checked against a SHA-256 checksum published with the release before anything is installed, so a corrupted or tampered download is never run."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Update settings. Automatic checking can be switched off in Settings, which also has a Check for updates button for checking on demand — it tells you either that an update is available or that you're already on the latest version."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="v0.0.8"
                        FontWeight="SemiBold"
                        FontSize="16"
                        Margin="0,12,0,0" />

                    <TextBlock
                        Text="• New: Speed units setting. Choose how network speeds are shown — megabits (Mb/s), megabytes (MB/s), or both — from Settings."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Automatic subnet detection. The app now works out your network's address range on its own and re-checks it whenever your connection changes (with a notification), so scans always cover the right range."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Updated device-vendor database. Refreshed to the latest IEEE registry, so more devices show the correct manufacturer."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Minor: renamed the Settings 'Device' tab to 'Devices', plus small fixes."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="v0.0.7"
                        FontWeight="SemiBold"
                        FontSize="16"
                        Margin="0,12,0,0" />

                    <TextBlock
                        Text="• New: Local network traffic. The Traffic page now has a Local tab showing which apps on this PC are talking to other devices on your network. Switch between By app and By device — the By device view makes a big transfer obvious, like a NAS backup climbing as a large upload. (Windows performs file-share/SMB copies in the kernel, so they show under System, tagged SMB, rather than the app that started them.)"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Live speed badge. While data is actively moving, the busy app or device shows a live throughput badge (e.g. 141 Mb/s · 18 MB/s) on both the Internet and Local tabs."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Fixed: downloads were being undercounted. A kernel-attribution bug caused most incoming (download) traffic — including reads from network shares, such as a NAS backup verify — to be dropped. Download figures are now accurate."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Cleaner Local view. Constant device-discovery chatter (from browsers and antivirus scanning the network) is folded into one collapsible row, and phantom entries for broadcast addresses and scanned-but-empty IPs are filtered out, so you see your real devices."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• More accurate speed tests. The speed test now uses parallel connections and measures sustained throughput, so results match speedtest.net and Cloudflare instead of reading low on fast connections. This uses more data per test — see the note next to the Speed Test setting."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Speed tests in reports. A failed (0-result) speed test now still appears in the charts and reports so you can see when the internet was down, and the daily-digest speed chart now matches the Speed Test page."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Consistent units. All sizes and speeds across the app — traffic totals, live speed badges, charts and the Speed Test — use decimal units (KB/MB/GB, ÷1000), matching your ISP and speedtest.net."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="v0.0.6"
                        FontWeight="SemiBold"
                        FontSize="16"
                        Margin="0,12,0,0" />

                    <TextBlock
                        Text="• Automatic device naming (mDNS/Bonjour). Devices that previously showed only an IP address — phones, and many Apple, Google and smart-home devices — now appear with a friendly name. This especially helps modern devices that use randomised MAC addresses, where vendor and hostname lookups come up blank."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• New Model column on the Devices list shows the hardware model for devices that publish it (e.g. Apple gear)."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Names with spaces and special characters display correctly, and meaningless internal identifiers are ignored, so you get a clean, readable name."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• The discovery runs during every scan with no noticeable slowdown, stays entirely on your machine, and never overwrites a friendly name you've set."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="v0.0.5"
                        FontWeight="SemiBold"
                        FontSize="16"
                        Margin="0,12,0,0" />

                    <TextBlock
                        Text="• Speed tests now run at the top of each hour and use larger 50 MB transfers with more latency samples, for more accurate results."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Speed-test latency is now measured the same way as Cloudflare's own web test, so the figure is accurate rather than inflated."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Speed-test times are now shown in your local time."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Throughput is now labelled Download/Upload (renamed from Received/Sent) and shown in both Mb/s and MB/s, colour-coded — on the Speed Test page and in the daily digest."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• The daily digest lists the most recent speed tests first."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• All charts now have labelled value axes (with units), an axis line and gridlines for easier reading."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• The Speed Test chart now displays correctly right after the very first test."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Scan and speed-test completions now also raise Windows toast notifications (when toasts are enabled); the speed-test toast shows both Mb/s and MB/s."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• New 'Data Folder' section in Settings shows what is stored on your PC, with a link to open the folder."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• New 'Release Notes' button in Settings (this screen)."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• When set to run at Windows startup, the app now starts minimised to the system tray."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• The app now remembers whether its window was maximised."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="• Device-history CSV files can no longer be imported as approved devices, preventing accidental imports."
                        TextWrapping="Wrap" />

                </StackPanel>

            </ScrollViewer>

        </ContentDialog>

    </Grid>

