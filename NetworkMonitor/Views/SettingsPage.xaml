<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="NetworkMonitor.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>

        <Style
            x:Key="SettingsCard"
            TargetType="Border">

            <Setter
                Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />

            <Setter
                Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefaultBrush}" />

            <Setter
                Property="BorderThickness"
                Value="1" />

            <Setter
                Property="CornerRadius"
                Value="6" />

            <Setter
                Property="Padding"
                Value="16" />

        </Style>

        <Style
            x:Key="SettingsCardHeader"
            TargetType="TextBlock">

            <Setter
                Property="FontSize"
                Value="14" />

            <Setter
                Property="FontWeight"
                Value="SemiBold" />

        </Style>

    </Page.Resources>

    <Grid
        RowDefinitions="Auto,*,Auto">

        <SelectorBar
            Grid.Row="0"
            x:Name="TabBar"
            FontSize="13"
            Margin="24,12,24,0"
            SelectionChanged="TabBarSelectionChanged">

            <SelectorBarItem
                AutomationProperties.AutomationId="SettingsTrafficTab"
                Tag="Traffic"
                Text="Traffic" />

            <SelectorBarItem
                AutomationProperties.AutomationId="SettingsDeviceTab"
                Tag="Device"
                Text="Devices" />

            <SelectorBarItem
                AutomationProperties.AutomationId="SettingsThemeTab"
                Tag="Theme"
                Text="Theme" />

            <SelectorBarItem
                AutomationProperties.AutomationId="SettingsOtherTab"
                Tag="Other"
                Text="Other" />

        </SelectorBar>

        <ScrollViewer
            Grid.Row="1"
            x:Name="TrafficPanel"
            Margin="0,8,0,0">

            <StackPanel
                HorizontalAlignment="Center"
                MaxWidth="480"
                Padding="24,16,24,16"
                Spacing="12">

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Sampling" />

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Scan Interval (seconds)" />

                            <NumberBox
                                AutomationProperties.AutomationId="TrafficIntervalSecondsBox"
                                Minimum="1"
                                Maximum="60"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="TrafficIntervalSecondsBoxValueChanged"
                                Value="{x:Bind ViewModel.TrafficIntervalSeconds, Mode=TwoWay}" />

                        </StackPanel>

                        <StackPanel
                            Spacing="4">

                            <ToggleSwitch
                                AutomationProperties.AutomationId="ChartSmoothScrollingToggle"
                                Header="Chart smooth scrolling"
                                IsOn="{x:Bind ViewModel.ChartSmoothScrolling, Mode=TwoWay}" />

                            <TextBlock
                                Text="When on, the Internet and Local traffic charts scroll continuously. When off, they redraw in place on each update (classic style, lighter on CPU)."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                        </StackPanel>

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Speed units" />

                            <ComboBox
                                AutomationProperties.AutomationId="SpeedUnitsComboBox"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="{x:Bind ViewModel.RateUnitModeIndex, Mode=TwoWay}">

                                <ComboBoxItem>

                                    <TextBlock>

                                        <Run
                                            Text="Both —" />

                                        <Run
                                            Text="MegaBits (Mb/s)"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DigestAccentTealBrush}" />

                                        <Run
                                            Text="·" />

                                        <Run
                                            Text="MegaBytes (MB/s)"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DigestAccentBlueBrush}" />

                                    </TextBlock>

                                </ComboBoxItem>

                                <ComboBoxItem>

                                    <TextBlock>

                                        <Run
                                            Text="MegaBits"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DigestAccentTealBrush}" />

                                        <Run
                                            Text="per second" />

                                        <Run
                                            Text="(Mb/s)"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DigestAccentTealBrush}" />

                                    </TextBlock>

                                </ComboBoxItem>

                                <ComboBoxItem>

                                    <TextBlock>

                                        <Run
                                            Text="MegaBytes"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DigestAccentBlueBrush}" />

                                        <Run
                                            Text="per second" />

                                        <Run
                                            Text="(MB/s)"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource DigestAccentBlueBrush}" />

                                    </TextBlock>

                                </ComboBoxItem>

                            </ComboBox>

                            <TextBlock
                                Text="How live speeds are shown across the app — traffic rate badges, chart axes, the Speed Test page, digest reports and toasts. CSV exports always include both units."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Speed test" />

                        <StackPanel
                            Spacing="4">

                            <ToggleSwitch
                                AutomationProperties.AutomationId="SpeedTestEnabledToggle"
                                Header="Run periodic speed tests (hourly)"
                                IsOn="{x:Bind ViewModel.SpeedTestEnabled, Mode=TwoWay}" />

                            <TextBlock
                                Text="Once an hour, measures download and upload throughput, latency and jitter using Cloudflare's free speed test service (speed.cloudflare.com) — no account or API key is required. The nearest Cloudflare data centre is used as the server. Use Run Speed Test on the Speed Test page for an immediate test."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Text="⚠ Warning: to measure accurately, each test saturates your line with parallel connections and uses roughly 750 MB, about 18 GB/day, for an hourly test. Turn this off if you're on a metered or capped connection."
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Data retention" />

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Purge traffic older than (days)" />

                            <NumberBox
                                AutomationProperties.AutomationId="TrafficPurgeDaysBox"
                                Minimum="0"
                                Maximum="7"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.TrafficPurgeDays, Mode=TwoWay}" />

                            <TextBlock
                                Text="Traffic history is kept for a maximum of 7 days. Set to 0 to disable automatic purging."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">

                            <Button
                                AutomationProperties.AutomationId="PurgeTrafficNowButton"
                                Content="Purge Now"
                                Click="PurgeTrafficNowClick" />

                            <TextBlock
                                VerticalAlignment="Center"
                                Opacity="0.65"
                                FontSize="12"
                                Text="{x:Bind ViewModel.TrafficPurgeStatus, Mode=OneWay}" />

                        </StackPanel>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <ScrollViewer
            Grid.Row="1"
            x:Name="DevicePanel"
            Visibility="Collapsed"
            Margin="0,8,0,0">

            <StackPanel
                HorizontalAlignment="Center"
                Width="480"
                Padding="24,16,24,16"
                Spacing="12">

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Network range" />

                        <StackPanel
                            Spacing="4">

                            <ToggleSwitch
                                AutomationProperties.AutomationId="AutoDetectSubnetToggle"
                                Header="Auto-detect subnet"
                                IsOn="{x:Bind ViewModel.AutoDetectSubnet, Mode=TwoWay}" />

                            <TextBlock
                                Text="When on, the subnet follows your active network connection — moving to a different network (e.g. taking a laptop elsewhere) is picked up automatically and triggers a scan. Turn off to scan a fixed subnet of your choice."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                        </StackPanel>

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Subnet Base (e.g. 192.168.1)" />

                            <TextBox
                                AutomationProperties.AutomationId="SubnetBaseTextBox"
                                IsEnabled="{x:Bind ViewModel.SubnetBaseEditable, Mode=OneWay}"
                                Text="{x:Bind ViewModel.SubnetBase, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        </StackPanel>

                        <Grid
                            ColumnDefinitions="*,Auto,*"
                            ColumnSpacing="8">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="4">

                                <TextBlock
                                    Text="Start Host" />

                                <NumberBox
                                    AutomationProperties.AutomationId="StartHostBox"
                                    Minimum="1"
                                    Maximum="254"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind ViewModel.StartHost, Mode=TwoWay}" />

                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                Text="–"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,8" />

                            <StackPanel
                                Grid.Column="2"
                                Spacing="4">

                                <TextBlock
                                    Text="End Host" />

                                <NumberBox
                                    AutomationProperties.AutomationId="EndHostBox"
                                    Minimum="1"
                                    Maximum="254"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind ViewModel.EndHost, Mode=TwoWay}" />

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Scan settings" />

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Scan Interval (minutes)" />

                            <NumberBox
                                AutomationProperties.AutomationId="ScanIntervalMinutesBox"
                                Minimum="1"
                                Maximum="60"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.IntervalMinutes, Mode=TwoWay}" />

                        </StackPanel>

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Ping Timeout (ms)" />

                            <NumberBox
                                AutomationProperties.AutomationId="PingTimeoutBox"
                                Minimum="100"
                                Maximum="5000"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.PingTimeoutMs, Mode=TwoWay}" />

                        </StackPanel>

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Max Parallel Pings" />

                            <NumberBox
                                AutomationProperties.AutomationId="MaxParallelPingsBox"
                                Minimum="10"
                                Maximum="254"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.MaxParallelPings, Mode=TwoWay}" />

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Data retention" />

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Purge history older than (days)" />

                            <NumberBox
                                AutomationProperties.AutomationId="HistoryPurgeDaysBox"
                                Minimum="0"
                                Maximum="3650"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.HistoryPurgeDays, Mode=TwoWay}" />

                            <TextBlock
                                Text="Set to 0 to disable automatic purging."
                                FontSize="12"
                                Opacity="0.65" />

                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">

                            <Button
                                AutomationProperties.AutomationId="PurgeHistoryNowButton"
                                Content="Purge Now"
                                Click="PurgeNowClick" />

                            <TextBlock
                                VerticalAlignment="Center"
                                Opacity="0.65"
                                FontSize="12"
                                Text="{x:Bind ViewModel.PurgeStatus, Mode=OneWay}" />

                        </StackPanel>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <ScrollViewer
            Grid.Row="1"
            x:Name="ThemePanel"
            Margin="0,8,0,0"
            Visibility="Collapsed">

            <StackPanel
                HorizontalAlignment="Center"
                MaxWidth="480"
                Padding="24,16,24,16"
                Spacing="12">

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Chart colours" />

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Colour scheme" />

                            <ComboBox
                                AutomationProperties.AutomationId="ChartSchemeComboBox"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.ChartSchemeNames}"
                                SelectedIndex="{x:Bind ViewModel.ChartSchemeIndex, Mode=TwoWay}" />

                            <TextBlock
                                Text="Applies to the Internet, Local and Speed test charts, the mini graph, and the coloured Download and Upload figures in the grids. The daily digest keeps its own fixed colours."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">

                            <StackPanel
                                Spacing="4">

                                <Button
                                    Padding="3"
                                    MinWidth="0"
                                    MinHeight="0"
                                    CornerRadius="4"
                                    ToolTipService.ToolTip="Choose the Download colour"
                                    IsHitTestVisible="{x:Bind ViewModel.IsCustomScheme, Mode=OneWay}">

                                    <Button.Flyout>

                                        <Flyout
                                            Closed="ChartColourFlyoutClosed">

                                            <ColorPicker
                                                IsAlphaEnabled="False"
                                                IsColorSliderVisible="True"
                                                IsMoreButtonVisible="True"
                                                Color="{x:Bind ViewModel.CustomDownloadColour, Mode=TwoWay}" />

                                        </Flyout>

                                    </Button.Flyout>

                                    <Rectangle
                                        Width="44"
                                        Height="20"
                                        Fill="{StaticResource ChartDownloadBrush}"
                                        RadiusX="3"
                                        RadiusY="3" />

                                </Button>

                                <TextBlock
                                    Text="Download"
                                    FontSize="11"
                                    Opacity="0.65" />

                            </StackPanel>

                            <StackPanel
                                Spacing="4">

                                <Button
                                    Padding="3"
                                    MinWidth="0"
                                    MinHeight="0"
                                    CornerRadius="4"
                                    ToolTipService.ToolTip="Choose the Upload colour"
                                    IsHitTestVisible="{x:Bind ViewModel.IsCustomScheme, Mode=OneWay}">

                                    <Button.Flyout>

                                        <Flyout
                                            Closed="ChartColourFlyoutClosed">

                                            <ColorPicker
                                                IsAlphaEnabled="False"
                                                IsColorSliderVisible="True"
                                                IsMoreButtonVisible="True"
                                                Color="{x:Bind ViewModel.CustomUploadColour, Mode=TwoWay}" />

                                        </Flyout>

                                    </Button.Flyout>

                                    <Rectangle
                                        Width="44"
                                        Height="20"
                                        Fill="{StaticResource ChartUploadBrush}"
                                        RadiusX="3"
                                        RadiusY="3" />

                                </Button>

                                <TextBlock
                                    Text="Upload"
                                    FontSize="11"
                                    Opacity="0.65" />

                            </StackPanel>

                            <StackPanel
                                Spacing="4">

                                <Button
                                    Padding="3"
                                    MinWidth="0"
                                    MinHeight="0"
                                    CornerRadius="4"
                                    ToolTipService.ToolTip="Choose the Latency colour"
                                    IsHitTestVisible="{x:Bind ViewModel.IsCustomScheme, Mode=OneWay}">

                                    <Button.Flyout>

                                        <Flyout
                                            Closed="ChartColourFlyoutClosed">

                                            <ColorPicker
                                                IsAlphaEnabled="False"
                                                IsColorSliderVisible="True"
                                                IsMoreButtonVisible="True"
                                                Color="{x:Bind ViewModel.CustomLatencyColour, Mode=TwoWay}" />

                                        </Flyout>

                                    </Button.Flyout>

                                    <Rectangle
                                        Width="44"
                                        Height="20"
                                        Fill="{StaticResource ChartLatencyBrush}"
                                        RadiusX="3"
                                        RadiusY="3" />

                                </Button>

                                <TextBlock
                                    Text="Latency"
                                    FontSize="11"
                                    Opacity="0.65" />

                            </StackPanel>

                            <StackPanel
                                Spacing="4">

                                <Button
                                    Padding="3"
                                    MinWidth="0"
                                    MinHeight="0"
                                    CornerRadius="4"
                                    ToolTipService.ToolTip="Choose the Jitter colour"
                                    IsHitTestVisible="{x:Bind ViewModel.IsCustomScheme, Mode=OneWay}">

                                    <Button.Flyout>

                                        <Flyout
                                            Closed="ChartColourFlyoutClosed">

                                            <ColorPicker
                                                IsAlphaEnabled="False"
                                                IsColorSliderVisible="True"
                                                IsMoreButtonVisible="True"
                                                Color="{x:Bind ViewModel.CustomJitterColour, Mode=TwoWay}" />

                                        </Flyout>

                                    </Button.Flyout>

                                    <Rectangle
                                        Width="44"
                                        Height="20"
                                        Fill="{StaticResource ChartJitterBrush}"
                                        RadiusX="3"
                                        RadiusY="3" />

                                </Button>

                                <TextBlock
                                    Text="Jitter"
                                    FontSize="11"
                                    Opacity="0.65" />

                            </StackPanel>

                            <StackPanel
                                Spacing="4">

                                <Button
                                    Padding="3"
                                    MinWidth="0"
                                    MinHeight="0"
                                    CornerRadius="4"
                                    ToolTipService.ToolTip="Choose the hover line colour"
                                    IsHitTestVisible="{x:Bind ViewModel.IsCustomScheme, Mode=OneWay}">

                                    <Button.Flyout>

                                        <Flyout
                                            Closed="ChartColourFlyoutClosed">

                                            <ColorPicker
                                                IsAlphaEnabled="False"
                                                IsColorSliderVisible="True"
                                                IsMoreButtonVisible="True"
                                                Color="{x:Bind ViewModel.CustomSelectionColour, Mode=TwoWay}" />

                                        </Flyout>

                                    </Button.Flyout>

                                    <Rectangle
                                        Width="44"
                                        Height="20"
                                        Fill="{StaticResource ChartSelectionBrush}"
                                        RadiusX="3"
                                        RadiusY="3" />

                                </Button>

                                <TextBlock
                                    Text="Hover"
                                    FontSize="11"
                                    Opacity="0.65" />

                            </StackPanel>

                        </StackPanel>

                        <TextBlock
                            Text="Select a swatch to choose that colour. Each one is adjusted automatically for the light and dark card backgrounds, so it always stays readable."
                            FontSize="12"
                            Opacity="0.65"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.IsCustomScheme, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Button
                            AutomationProperties.AutomationId="ResetChartSchemeButton"
                            Content="Reset to Classic"
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.ResetChartSchemeCommand}" />

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Preview" />

                        <TextBlock
                            Text="Sample data, not your traffic. It shows every colour the scheme sets, including the hover line, which on a real chart only appears while you point at it or after you select a point."
                            FontSize="12"
                            Opacity="0.65"
                            TextWrapping="Wrap" />

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Internet and Local charts"
                                FontSize="11"
                                Opacity="0.65" />

                            <Border
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="0">

                                <Viewbox
                                    Height="110"
                                    Stretch="Fill">

                                    <Grid
                                        Width="398"
                                        Height="110">

                                        <Line
                                            X1="0"
                                            Y1="32"
                                            X2="398"
                                            Y2="32"
                                            Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                            StrokeThickness="1" />

                                        <Line
                                            X1="0"
                                            Y1="63"
                                            X2="398"
                                            Y2="63"
                                            Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                            StrokeThickness="1" />

                                        <Polygon
                                            Points="0,70 25,62 50,48 75,55 100,30 125,42 150,22 175,38 200,28 225,52 250,40 275,58 300,34 325,46 350,26 375,44 398,36 398,95 0,95"
                                            Fill="{StaticResource ChartDownloadBrush}"
                                            Opacity="0.35" />

                                        <Polyline
                                            Points="0,70 25,62 50,48 75,55 100,30 125,42 150,22 175,38 200,28 225,52 250,40 275,58 300,34 325,46 350,26 375,44 398,36"
                                            Stroke="{StaticResource ChartDownloadBrush}"
                                            StrokeThickness="2" />

                                        <Polygon
                                            Points="0,84 25,80 50,86 75,74 100,82 125,70 150,80 175,76 200,88 225,72 250,82 275,78 300,86 325,74 350,84 375,80 398,86 398,95 0,95"
                                            Fill="{StaticResource ChartUploadBrush}"
                                            Opacity="0.35" />

                                        <Polyline
                                            Points="0,84 25,80 50,86 75,74 100,82 125,70 150,80 175,76 200,88 225,72 250,82 275,78 300,86 325,74 350,84 375,80 398,86"
                                            Stroke="{StaticResource ChartUploadBrush}"
                                            StrokeThickness="2" />

                                        <Line
                                            X1="290"
                                            Y1="6"
                                            X2="290"
                                            Y2="104"
                                            Stroke="{StaticResource ChartSelectionBrush}"
                                            StrokeThickness="1.5"
                                            StrokeDashArray="3,3" />

                                    </Grid>

                                </Viewbox>

                            </Border>

                        </StackPanel>

                        <StackPanel
                            Spacing="4">

                            <TextBlock
                                Text="Speed test chart"
                                FontSize="11"
                                Opacity="0.65" />

                            <Border
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="0">

                                <Viewbox
                                    Height="72"
                                    Stretch="Fill">

                                    <Grid
                                        Width="398"
                                        Height="72">

                                        <Line
                                            X1="0"
                                            Y1="36"
                                            X2="398"
                                            Y2="36"
                                            Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                            StrokeThickness="1" />

                                        <Polyline
                                            Points="0,42 40,34 80,48 120,30 160,40 200,26 240,46 280,32 320,44 360,28 398,38"
                                            Stroke="{StaticResource ChartLatencyBrush}"
                                            StrokeThickness="2" />

                                        <Polyline
                                            Points="0,60 40,56 80,62 120,54 160,60 200,52 240,64 280,56 320,60 360,54 398,58"
                                            Stroke="{StaticResource ChartJitterBrush}"
                                            StrokeThickness="2" />

                                    </Grid>

                                </Viewbox>

                            </Border>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <ScrollViewer
            Grid.Row="1"
            x:Name="OtherPanel"
            Visibility="Collapsed"
            Margin="0,8,0,0">

            <StackPanel
                HorizontalAlignment="Center"
                Width="480"
                Padding="24,16,24,16"
                Spacing="12">

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Startup" />

                        <StackPanel
                            Spacing="4">

                            <ToggleSwitch
                                AutomationProperties.AutomationId="RunAtStartupToggle"
                                Header="Run at Windows startup"
                                IsOn="{x:Bind ViewModel.RunAtStartup, Mode=TwoWay}" />

                            <TextBlock
                                Text="Starts Umnatha Network Monitor automatically when you sign in, with the elevated permissions needed for per-process traffic — without a UAC prompt (uses a Windows scheduled task)."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Notifications" />

                        <ToggleSwitch
                            AutomationProperties.AutomationId="ShowToastsToggle"
                            Header="Show Toast Notifications"
                            IsOn="{x:Bind ViewModel.ShowToasts, Mode=TwoWay}" />

                        <CheckBox
                            AutomationProperties.AutomationId="UnapprovedOnlyToastsCheckBox"
                            Content="Unapproved devices only"
                            Margin="8,0,0,0"
                            IsChecked="{x:Bind ViewModel.UnapprovedOnlyToasts, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.ShowToasts, Mode=OneWay}" />

                    </StackPanel>

                </Border>

                <Border
                    Style="{StaticResource SettingsCard}">

                    <StackPanel
                        Spacing="12">

                        <TextBlock
                            Style="{StaticResource SettingsCardHeader}"
                            Text="Software updates" />

                        <ToggleSwitch
                            AutomationProperties.AutomationId="AutoCheckForUpdatesToggle"
                            Header="Automatically check for updates"
