<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="NetworkMonitor.Views.SpeedTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:chart="using:NetworkMonitor.Views.Controls"
    xmlns:models="using:NetworkMonitor.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid
        RowDefinitions="Auto,Auto,*,Auto"
        Padding="16,12,16,12">

        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Margin="0,0,0,4">

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8">

                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />

                <Button
                    Content="Export CSV"
                    Click="ExportCsvClick" />

                <Button
                    Content="Run Speed Test"
                    Margin="12,0,12,0"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.RunNowCommand}" />

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4">

                    <Button
                        x:Name="Range7dButton"
                        Content="7d"
                        Tag="168"
                        Padding="10,5"
                        Click="RangeButtonClick" />

                    <Button
                        x:Name="Range24hButton"
                        Content="24h"
                        Tag="24"
                        Padding="10,5"
                        Click="RangeButtonClick" />

                </StackPanel>

            </StackPanel>

        </Grid>

        <StackPanel
            Grid.Row="1"
            Spacing="10"
            Margin="0,0,0,10">

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="20"
                    VerticalAlignment="Center">

                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Opacity="0.7"
                        VerticalAlignment="Center"
                        Text="Last Test" />

                    <StackPanel
                        Spacing="1">

                        <TextBlock
                            FontSize="11"
                            Opacity="0.55"
                            Text="Download" />

                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="#1976D2"
                            Text="{x:Bind ViewModel.Latest.DownloadMbps, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='0.0 Mbps'}" />

                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="#1976D2"
                            Text="{x:Bind ViewModel.Latest.DownloadMBps, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='0.0 MBps'}" />

                    </StackPanel>

                    <StackPanel
                        Spacing="1">

                        <TextBlock
                            FontSize="11"
                            Opacity="0.55"
                            Text="Upload" />

                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="#AB47BC"
                            Text="{x:Bind ViewModel.Latest.UploadMbps, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='0.0 Mbps'}" />

                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="#AB47BC"
                            Text="{x:Bind ViewModel.Latest.UploadMBps, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='0.0 MBps'}" />

                    </StackPanel>

                    <StackPanel
                        Spacing="1">

                        <TextBlock
                            FontSize="11"
                            Opacity="0.55"
                            Text="Latency (ms)" />

                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.Latest.LatencyMs, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='0'}" />

                    </StackPanel>

                    <StackPanel
                        Spacing="1">

                        <TextBlock
                            FontSize="11"
                            Opacity="0.55"
                            Text="Jitter (ms)" />

                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.Latest.JitterMs, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='0'}" />

                    </StackPanel>

                </StackPanel>

            </Border>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">

                <StackPanel
                    Spacing="8">

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <TextBlock
                            Grid.Column="0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Opacity="0.7"
                            VerticalAlignment="Center"
                            Text="Throughput (Mbps/MBps)" />

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="12">

                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="4">

                                <Rectangle
                                    Width="10"
                                    Height="10"
                                    VerticalAlignment="Center"
                                    Fill="#1976D2"
                                    RadiusX="2"
                                    RadiusY="2" />

                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.7"
                                    Text="Download" />

                            </StackPanel>

                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="4">

                                <Rectangle
                                    Width="10"
                                    Height="10"
                                    VerticalAlignment="Center"
                                    Fill="#AB47BC"
                                    RadiusX="2"
                                    RadiusY="2" />

                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.7"
                                    Text="Upload" />

                            </StackPanel>

                        </StackPanel>

                    </Grid>

                    <chart:SpeedTrendChart
                        x:Name="ThroughputChart"
                        Height="110"
                        Unit="Mbps"
                        SecondaryUnit="MBps"
                        SecondaryDivisor="8"
                        Series="{x:Bind ViewModel.ThroughputSeries, Mode=OneWay}" />

                </StackPanel>

            </Border>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">

                <StackPanel
                    Spacing="8">

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <TextBlock
                            Grid.Column="0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Opacity="0.7"
                            VerticalAlignment="Center"
                            Text="Latency / Jitter (ms)" />

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="12">

                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="4">

                                <Rectangle
                                    Width="10"
                                    Height="10"
                                    VerticalAlignment="Center"
                                    Fill="#F57C00"
                                    RadiusX="2"
                                    RadiusY="2" />

                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.7"
                                    Text="Latency" />

                            </StackPanel>

                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="4">

                                <Rectangle
                                    Width="10"
                                    Height="10"
                                    VerticalAlignment="Center"
                                    Fill="#2E7D32"
                                    RadiusX="2"
                                    RadiusY="2" />

                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.7"
                                    Text="Jitter" />

                            </StackPanel>

                        </StackPanel>

                    </Grid>

                    <chart:SpeedTrendChart
                        x:Name="LatencyChart"
                        Height="110"
                        Unit="ms"
                        Series="{x:Bind ViewModel.LatencySeries, Mode=OneWay}" />

                </StackPanel>

            </Border>

        </StackPanel>

        <controls:DataGrid
            Grid.Row="2"
            x:Name="HistoryGrid"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            GridLinesVisibility="Horizontal"
            SelectionMode="Single"
            CanUserSortColumns="True"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Sorting="DataGridSorting"
            ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}">

            <controls:DataGrid.Columns>

                <controls:DataGridTextColumn
                    Header="Time"
                    Width="*"
                    Binding="{Binding LocalTimestamp}" />

                <controls:DataGridTemplateColumn
                    Header="Download (Mbps)"
                    Width="150"
                    CanUserSort="True"
                    Tag="DownloadMbps">

                    <controls:DataGridTemplateColumn.CellTemplate>

                        <DataTemplate
                            x:DataType="models:SpeedTestResult">

                            <TextBlock
                                Foreground="#4DB6AC"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center"
                                Text="{x:Bind DownloadMbps, Converter={StaticResource DoubleFormatConverter}, ConverterParameter=0.0}" />

                        </DataTemplate>

                    </controls:DataGridTemplateColumn.CellTemplate>

                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn
                    Header="Upload (Mbps)"
                    Width="150"
                    CanUserSort="True"
                    Tag="UploadMbps">

                    <controls:DataGridTemplateColumn.CellTemplate>

                        <DataTemplate
                            x:DataType="models:SpeedTestResult">

                            <TextBlock
                                Foreground="#4DB6AC"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center"
                                Text="{x:Bind UploadMbps, Converter={StaticResource DoubleFormatConverter}, ConverterParameter=0.0}" />

                        </DataTemplate>

                    </controls:DataGridTemplateColumn.CellTemplate>

                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn
                    Header="Download (MBps)"
                    Width="150"
                    CanUserSort="True"
                    Tag="DownloadMBps">

                    <controls:DataGridTemplateColumn.CellTemplate>

                        <DataTemplate
                            x:DataType="models:SpeedTestResult">

                            <TextBlock
                                Foreground="#7FA8C9"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center"
                                Text="{x:Bind DownloadMBps, Converter={StaticResource DoubleFormatConverter}, ConverterParameter=0.0}" />

                        </DataTemplate>

                    </controls:DataGridTemplateColumn.CellTemplate>

                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn
                    Header="Upload (MBps)"
                    Width="150"
                    CanUserSort="True"
                    Tag="UploadMBps">

                    <controls:DataGridTemplateColumn.CellTemplate>

                        <DataTemplate
                            x:DataType="models:SpeedTestResult">

                            <TextBlock
                                Foreground="#7FA8C9"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center"
                                Text="{x:Bind UploadMBps, Converter={StaticResource DoubleFormatConverter}, ConverterParameter=0.0}" />

                        </DataTemplate>

                    </controls:DataGridTemplateColumn.CellTemplate>

                </controls:DataGridTemplateColumn>

                <controls:DataGridTextColumn
                    Header="Latency (ms)"
                    Width="115"
                    Binding="{Binding LatencyMs, Converter={StaticResource DoubleFormatConverter}, ConverterParameter=0}" />

                <controls:DataGridTextColumn
                    Header="Jitter (ms)"
                    Width="105"
                    Binding="{Binding JitterMs, Converter={StaticResource DoubleFormatConverter}, ConverterParameter=0}" />

                <controls:DataGridTextColumn
                    Header="Server"
                    Width="100"
                    Binding="{Binding Server}" />

            </controls:DataGrid.Columns>

        </controls:DataGrid>

        <TextBlock
            Grid.Row="3"
            x:Name="StatusText"
            Margin="0,8,0,0"
            Opacity="0.65"
            FontSize="12" />

    </Grid>

</Page>
