<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="NetworkMonitor.Views.ApprovedDevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:models="using:NetworkMonitor.Models.Devices"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid
        RowDefinitions="Auto,*,Auto"
        Padding="16,12,16,12">

        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto,Auto,Auto,Auto"
            Margin="0,0,0,10"
            ColumnSpacing="8">

            <AutoSuggestBox
                AutomationProperties.AutomationId="ApprovedDevicesSearchBox"
                Grid.Column="0"
                PlaceholderText="Search Type, Name, IP, MAC…"
                MaxWidth="380"
                HorizontalAlignment="Left"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />

            <ProgressRing
                Grid.Column="1"
                Width="24"
                Height="24"
                IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />

            <Button
                AutomationProperties.AutomationId="ExportCsvButton"
                Grid.Column="2"
                Content="Export CSV"
                Click="ExportButtonClick" />

            <Button
                AutomationProperties.AutomationId="ImportCsvButton"
                Grid.Column="3"
                Content="Import CSV"
                Click="ImportButtonClick" />

            <Button
                AutomationProperties.AutomationId="ApprovedDevicesScanNowButton"
                Grid.Column="4"
                Content="Scan Network"
                Style="{StaticResource AccentButtonStyle}"
                Margin="32,0,0,0"
                Command="{x:Bind ViewModel.ScanNowCommand}" />

        </Grid>

        <controls:DataGrid
            AutomationProperties.AutomationId="ApprovedDevicesGrid"
            Grid.Row="1"
            x:Name="DeviceGrid"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            GridLinesVisibility="Horizontal"
            SelectionMode="Single"
            CanUserSortColumns="True"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Sorting="DataGridSorting"
            SelectionChanged="DeviceGridSelectionChanged"
            ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}">

            <controls:DataGrid.Columns>

                <controls:DataGridTemplateColumn
                    Header="Status"
                    Width="80">

                    <controls:DataGridTemplateColumn.CellTemplate>

                        <DataTemplate
                            x:DataType="models:Device">

                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="6"
                                Padding="8,0,0,0">

                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Fill="{x:Bind IsOnline,
                                               Converter={StaticResource OnlineStatusConverter},
                                               ConverterParameter=brush,
                                               Mode=OneWay}" />

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Text="{x:Bind LastSeenLabel, Mode=OneWay}" />

                            </StackPanel>

                        </DataTemplate>

                    </controls:DataGridTemplateColumn.CellTemplate>

                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn
                    Header="Type"
                    Width="140">

                    <controls:DataGridTemplateColumn.CellTemplate>

                        <DataTemplate
                            x:DataType="models:Device">

                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="6"
                                Padding="8,0,0,0">

                                <TextBlock
                                    FontFamily="Segoe UI Emoji"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind TypeIcon, Mode=OneWay}" />

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Type, Mode=OneWay}" />

                            </StackPanel>

                        </DataTemplate>

                    </controls:DataGridTemplateColumn.CellTemplate>

                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn
                    Header="Name"
                    Width="300">

                    <controls:DataGridTemplateColumn.CellTemplate>

                        <DataTemplate
                            x:DataType="models:Device">

                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="6"
                                Padding="8,0,0,0">

                                <TextBlock
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="{x:Bind Notes, Converter={StaticResource NotesToolTipConverter}, Mode=OneWay}"
                                    Text="{x:Bind DisplayName, Mode=OneWay}" />

                                <Border
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="6,1,6,1"
                                    ToolTipService.ToolTip="This machine — the PC running Network Monitor."
                                    Visibility="{x:Bind IsHost, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">

                                    <TextBlock
                                        Text="Host"
                                        FontSize="10"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}" />

                                </Border>

                                <Border
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="6,1,6,1"
                                    ToolTipService.ToolTip="Private (randomized) MAC — phones rotate these, so tracking is best-effort."
                                    Visibility="{x:Bind IsRandomizedMac, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">

                                    <TextBlock
                                        Text="Private MAC"
                                        FontSize="10"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}" />

                                </Border>

                            </StackPanel>

                        </DataTemplate>

                    </controls:DataGridTemplateColumn.CellTemplate>

                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn
                    Header="IP Address"
                    Width="155">

                    <controls:DataGridTemplateColumn.CellTemplate>

                        <DataTemplate
                            x:DataType="models:Device">

                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="4"
                                Padding="8,0,0,0">

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind IpAddress, Mode=OneWay}" />

                                <Button
                                    Content="&#xE8C8;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="11"
                                    Padding="3"
                                    Width="20"
                                    Height="20"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    ToolTipService.ToolTip="Copy IP"
                                    Click="CopyButtonClick"
                                    Tag="{x:Bind IpAddress, Mode=OneWay}" />

                            </StackPanel>

                        </DataTemplate>

                    </controls:DataGridTemplateColumn.CellTemplate>

                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn
                    Header="MAC Address"
                    Width="190">

                    <controls:DataGridTemplateColumn.CellTemplate>

                        <DataTemplate
                            x:DataType="models:Device">

                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="4"
                                Padding="8,0,0,0">

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind MacAddress, Mode=OneWay}" />

                                <Button
                                    Content="&#xE8C8;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="11"
                                    Padding="3"
                                    Width="20"
                                    Height="20"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    ToolTipService.ToolTip="Copy MAC"
                                    Click="CopyButtonClick"
                                    Tag="{x:Bind MacAddress, Mode=OneWay}" />

                            </StackPanel>

                        </DataTemplate>

                    </controls:DataGridTemplateColumn.CellTemplate>

                </controls:DataGridTemplateColumn>

                <controls:DataGridTextColumn
                    Header="Vendor"
                    Width="200"
                    Binding="{Binding Vendor}" />

                <controls:DataGridTemplateColumn
                    Header="Actions"
                    Width="260">

                    <controls:DataGridTemplateColumn.CellTemplate>

                        <DataTemplate
                            x:DataType="models:Device">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4"
                                Padding="4,0,0,0">

                                <Button
                                    AutomationProperties.AutomationId="EditDeviceButton"
                                    Content="Edit"
                                    Padding="8,4"
                                    Click="EditButtonClick"
                                    Tag="{x:Bind}" />

                                <Button
                                    Content="History"
                                    Padding="8,4"
                                    Click="HistoryButtonClick"
                                    Tag="{x:Bind MacAddress, Mode=OneWay}" />

                                <Button
                                    AutomationProperties.AutomationId="DeleteDeviceButton"
                                    Content="Delete"
                                    Padding="8,4"
                                    Click="DeleteButtonClick"
                                    Tag="{x:Bind}" />

                            </StackPanel>

                        </DataTemplate>

                    </controls:DataGridTemplateColumn.CellTemplate>

                </controls:DataGridTemplateColumn>

            </controls:DataGrid.Columns>

        </controls:DataGrid>

        <TextBlock
            Grid.Row="2"
            Margin="0,8,0,0"
            Opacity="0.65"
            FontSize="12"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />

    </Grid>

</Page>
