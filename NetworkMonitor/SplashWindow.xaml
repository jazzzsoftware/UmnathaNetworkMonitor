<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="NetworkMonitor.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        x:Name="RootBorder"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">

                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="14">

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="34"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        TextWrapping="NoWrap"
                        Text="Umnatha Network Monitor" />

                    <Image
                        x:Name="LogoImage"
                        Width="64"
                        Height="64"
                        VerticalAlignment="Center" />

                </StackPanel>

                <ProgressRing
                    Width="28"
                    Height="28"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    IsActive="True" />

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="20"
                    Opacity="0.55"
                    Text="Starting…" />

            </StackPanel>

        </Grid>

    </Border>

</Window>
