<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="NetworkMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Umnatha Network Monitor">

    <Grid>

    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        PaneDisplayMode="Left"
        OpenPaneLength="200"
        SelectionChanged="NavViewSelectionChanged"
        Loaded="NavViewLoaded">

        <NavigationView.MenuItems>

            <NavigationViewItem
                Content="Traffic"
                Tag="traffic">

                <NavigationViewItem.Icon>

                    <FontIcon
                        Glyph="&#xE9D2;" />

                </NavigationViewItem.Icon>

            </NavigationViewItem>

            <NavigationViewItem
                Content="Devices"
                Tag="devices">

                <NavigationViewItem.Icon>

                    <FontIcon
                        Glyph="&#xE839;" />

                </NavigationViewItem.Icon>

            </NavigationViewItem>

            <NavigationViewItem
                Content="Reports"
                Tag="reports">

                <NavigationViewItem.Icon>

                    <FontIcon
                        Glyph="&#xE9F9;" />

                </NavigationViewItem.Icon>

            </NavigationViewItem>

        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>

            <StackPanel
                Margin="16,0,16,16"
                Spacing="2">

                <TextBlock
                    Text="Last Device Scan"
                    FontSize="10"
                    Opacity="0.5"
                    CharacterSpacing="50" />

                <TextBlock
                    x:Name="LastScanText"
                    Text="—"
                    FontSize="12"
                    Opacity="0.75" />

                <TextBlock
                    Text="Next Device Scan"
                    FontSize="10"
                    Opacity="0.5"
                    CharacterSpacing="50"
                    Margin="0,6,0,0" />

                <TextBlock
                    x:Name="NextScanText"
                    Text="—"
                    FontSize="12"
                    Opacity="0.75" />

            </StackPanel>

        </NavigationView.PaneFooter>

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition
                    Height="Auto" />

                <RowDefinition
                    Height="*" />

            </Grid.RowDefinitions>

            <InfoBar
                Grid.Row="0"
                Title="Software update"
                IsClosable="False"
                IsOpen="{x:Bind UpdateViewModel.IsBannerOpen, Mode=TwoWay}"
                Severity="{x:Bind UpdateViewModel.Severity, Mode=OneWay}"
                Message="{x:Bind UpdateViewModel.Message, Mode=OneWay}">

                <InfoBar.Content>

                    <StackPanel
                        Margin="0,8,0,12"
                        Spacing="12">

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12"
                            Visibility="{x:Bind UpdateViewModel.IsBusy, Mode=OneWay}">

                            <ProgressBar
                                Width="240"
                                VerticalAlignment="Center"
                                Maximum="100"
                                Value="{x:Bind UpdateViewModel.DownloadProgress, Mode=OneWay}" />

                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind UpdateViewModel.DownloadProgressText, Mode=OneWay}" />

                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind UpdateViewModel.HasPendingUpdate, Mode=OneWay}">

                            <Button
                                Content="Update now"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind UpdateViewModel.IsNotBusy, Mode=OneWay}"
                                Command="{x:Bind UpdateViewModel.UpdateNowCommand}" />

                            <Button
                                Content="Later"
                                IsEnabled="{x:Bind UpdateViewModel.IsNotBusy, Mode=OneWay}"
                                Command="{x:Bind UpdateViewModel.DismissCommand}" />

                        </StackPanel>

                        <Button
                            Content="Dismiss"
                            HorizontalAlignment="Left"
                            Visibility="{x:Bind UpdateViewModel.HasNoPendingUpdate, Mode=OneWay}"
                            Command="{x:Bind UpdateViewModel.DismissCommand}" />

                    </StackPanel>

                </InfoBar.Content>

            </InfoBar>

            <Frame
                x:Name="ContentFrame"
                Grid.Row="1" />

        </Grid>

    </NavigationView>

    <Border
        x:Name="ToastBorder"
        Margin="0,0,0,48"
        Padding="20,12"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        CornerRadius="8"
        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
        BorderThickness="1"
        Opacity="0"
        IsHitTestVisible="False">

        <TextBlock
            x:Name="ToastText"
            FontSize="14" />

    </Border>

    </Grid>

</Window>
